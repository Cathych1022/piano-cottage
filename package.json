{
  "name": "piano-cottage",
  "version": "1.0.0",
  "private": true,
  "description": "Piano Cottage web app and iOS app",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build-app.mjs",
